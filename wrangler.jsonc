{
  // Cloudflare Workers (static assets) 用の設定。
  // Vite のビルド成果物 dist/ を配信する。デプロイ前に npm run build が必要。
  "name": "hanautai",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "hanautai.mct-official.com", "custom_domain": true }
  ]
}
